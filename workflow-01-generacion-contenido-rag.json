      "onError": "continueErrorOutput",
      "notes": "Trae los 5 registros atómicos (Tema, Descripcion, Datos_Contexto, Tono_Comunicacion) como fuente de verdad."
    },
    {
      "parameters": {
        "jsCode": "const trigger = $('Nueva Idea Semilla').first().json;\nconst idea = (trigger.fields || trigger).Idea_Semilla;\nconst recordId = trigger.id;\n\nconst ragRows = $input.all().map(i => i.json.fields || i.json);\n\nconst contexto = ragRows\n  .map(r => `- Tema: ${r.Tema}\\n  Descripcion: ${r.Descripcion}\\n  Datos: ${r.Datos_Contexto}\\n  Tono: ${r.Tono_Comunicacion}`)\n  .join('\\n');\n\nconst prompt = `Sos un redactor de contenido B2B para una consultora de pymes argentinas.\nUsá EXCLUSIVAMENTE el siguiente contexto validado, nunca conocimiento externo:\n${contexto}\n\nIdea semilla: ${idea}\n\nRedactá un post de LinkedIn breve, profesional, con el tono indicado en el contexto correspondiente al tema.`;\n\nreturn [{ json: { recordId, idea, prompt } }];"
      },
      "id": "20eaa6ad-fd9b-4592-a304-68a52007a7d8",
      "name": "Armar Prompt con Contexto RAG",
